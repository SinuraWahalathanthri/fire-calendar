# Copy to .env and fill in. Without FIRMS_MAP_KEY the app runs on synthetic demo data.
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

PORT=8080
# Poll FIRMS near-real-time feeds every N minutes (FIRMS updates roughly every 1-3 h per satellite)
POLL_MINUTES=15
GLOBAL_POLL_MINUTES=30

# Start of the historical record (MODIS Terra began Nov 2000)
HISTORY_START=2000-11-01
# MODIS <-> VIIRS calibration overlap window (Terra drifted after 2022)
CALIB_START=2012-02
CALIB_END=2021-12

# Comma-separated bearer tokens required for creating/deleting alert rules and imports (empty = open)
API_TOKENS=

# FIRMS API pacing: key limit is 5000 transactions / 10 min and a country-sized request costs ~10.
# The server also watches live key usage and pauses near the limit.
FIRMS_CONCURRENCY=3
FIRMS_MAX_PER_10MIN=450
FIRMS_DAY_RANGE=5
